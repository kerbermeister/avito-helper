# Образы в GitHub Container Registry: ghcr.io/<USERNAME>/<repo>
IMAGE_PREFIX=ghcr.io/USERNAME/avito-helper

# Домен (Caddy получит HTTPS-сертификат автоматически)
DOMAIN=avito.example.com

# PostgreSQL
POSTGRES_DB=avito_helper
POSTGRES_USER=avito
POSTGRES_PASSWORD=change-me

# Хранилище файлов
# local — файлы в Docker-томе (просто, для одного VPS)
# s3    — объектное хранилище (Cloudflare R2 / Yandex Object Storage / Garage / SeaweedFS)
STORAGE_TYPE=local

# Настройки S3 (нужны только если STORAGE_TYPE=s3)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=avito-helper

# Backend
# JWT_SECRET: случайная строка >= 32 символов. Сгенерировать: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# faster-whisper
# Модель small ~460 МБ (хватает для коротких фраз). Для лучшего качества и если VPS
# с 4+ ГБ RAM можно поставить medium или large-v3-turbo (~1.5 ГБ).
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Gemini (разбивка надиктованного объявления на поля title/description/category)
# enabled=false — полностью отключить провайдера (не будет ни попытки, ни фолбэка на него)
GEMINI_ENABLED=true
# Ключ: https://aistudio.google.com/apikey (бесплатно)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenAI (запасной провайдер структуризации)
# enabled=false — полностью отключить провайдера
OPENAI_ENABLED=true
# Ключ: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Логи бэкенда. Папка ./log монтируется в контейнер как /logs,
# поэтому путь должен быть внутри /logs. Можно не задавать — по умолчанию /logs/avito-helper.log.
# На хосте файл появится в deploy/log/avito-helper.log
# LOG_FILE=/logs/avito-helper.log
