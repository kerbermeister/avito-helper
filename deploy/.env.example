# Домен (Caddy получит HTTPS-сертификат автоматически)
DOMAIN=avito.example.com

# PostgreSQL
POSTGRES_DB=avito_helper
POSTGRES_USER=avito
POSTGRES_PASSWORD=change-me

# Хранилище файлов
# local — файлы в Docker-томе (просто, для одного VPS)
# s3    — объектное хранилище (Cloudflare R2 / Yandex Object Storage / Garage / SeaweedFS)
STORAGE_TYPE=local

# Настройки S3 (нужны только если STORAGE_TYPE=s3)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=avito-helper

# Backend
# JWT_SECRET: случайная строка >= 32 символов (256 бит). Сгенерировать: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# faster-whisper (для GPU поставьте WHISPER_DEVICE=cuda)
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
